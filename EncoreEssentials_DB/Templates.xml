<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
	<!-- Row kinds for Encore-DB's scroll lists. The scroll box pools frames by template name, so each kind
	     keeps its own frames; Window.lua builds each row's contents the first time it is used. -->
	<Button name="EncoreDBTreeRowTemplate" virtual="true"/>
	<Button name="EncoreDBSectionRowTemplate" virtual="true"/>
	<Button name="EncoreDBHeadRowTemplate" virtual="true"/>
	<Button name="EncoreDBColsRowTemplate" virtual="true"/>
	<Button name="EncoreDBItemRowTemplate" virtual="true"/>
	<Button name="EncoreDBLineRowTemplate" virtual="true"/>
	<Button name="EncoreDBToggleRowTemplate" virtual="true"/>
	<!-- Quest view (QuestView.lua) -->
	<Button name="EncoreDBQuestFilterRowTemplate" virtual="true"/>
	<Button name="EncoreDBQuestChainRowTemplate" virtual="true"/>
	<Button name="EncoreDBQuestRowTemplate" virtual="true"/>
	<Button name="EncoreDBQuestTextRowTemplate" virtual="true"/>
</Ui>
