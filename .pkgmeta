# CurseForge packaging (BigWigs packager / CurseForge automatic packaging).
# Each addon folder listed under move-folders becomes a top-level folder in the zip.
package-as: EncoreEssentials

move-folders:
  EncoreEssentials/EncoreEssentials: EncoreEssentials
  EncoreEssentials/EncoreEssentials_DB: EncoreEssentials_DB
  EncoreEssentials/EncoreEssentials_Stonks: EncoreEssentials_Stonks
  EncoreEssentials/EncoreEssentials_QoL: EncoreEssentials_QoL
  EncoreEssentials/EncoreEssentials_PvP: EncoreEssentials_PvP
  EncoreEssentials/EncoreEssentials_Professions: EncoreEssentials_Professions

ignore:
  # Encore-Alts stays in the repository but is not released (Det, 2026-11-26).
  - EncoreEssentials_Alts
  - tools
  - docs
  - assets
  - README.md
  - CLAUDE.md
  - CLAUDE.local.md
  - "*.zip"
  - "*.whl"
  - .github

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
